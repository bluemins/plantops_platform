# Copy to .env (or run scripts/setup-local-db.sh, which generates it). Never commit real values.
# Three database logins - see CLAUDE.md "Row-level security rules":
#   OWNER = migrations only, APP = plant-user requests (RLS), SUPER = super_admin routes only
DATABASE_URL_OWNER=postgres://plantops_owner:CHANGE_ME@localhost:5432/plantops
DATABASE_URL_APP=postgres://platform_app:CHANGE_ME@localhost:5432/plantops
DATABASE_URL_SUPER=postgres://platform_super:CHANGE_ME@localhost:5432/plantops
TEST_DATABASE_URL_OWNER=postgres://plantops_owner:CHANGE_ME@localhost:5432/plantops_test
TEST_DATABASE_URL_APP=postgres://platform_app:CHANGE_ME@localhost:5432/plantops_test
TEST_DATABASE_URL_SUPER=postgres://platform_super:CHANGE_ME@localhost:5432/plantops_test
PLATFORM_URL=http://localhost:3000
# Ed25519 private key for signing SSO tokens: output of `pnpm sso:keygen`
SSO_PRIVATE_JWK_B64=
# Optional: old public key (base64 JWK) still published during a key change
SSO_PREVIOUS_PUBLIC_JWK_B64=
# Optional: phone notifications (Web Push), output of `pnpm --filter @plantops/platform push:keys`. Platform only;
# each copy has its own pair. Without them the launcher bell still works and phones get nothing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@bluemins.life
# First super_admin, created by `pnpm db:seed`
SUPER_ADMIN_EMAIL=admin@plantops.local
SUPER_ADMIN_PASSWORD=
# Optional per module: URL and client secret, registered by `pnpm db:seed`
# MODULE_URL_LAB_RECORDS=http://localhost:3001
# MODULE_SECRET_LAB_RECORDS=
# Lab Records module (written by scripts/setup-lab-db.sh). Its migrations run with DATABASE_URL_OWNER.
LAB_DATABASE_URL_APP=postgres://lab_app:CHANGE_ME@localhost:5432/plantops
TEST_LAB_DATABASE_URL_APP=postgres://lab_app:CHANGE_ME@localhost:5432/plantops_test
# The module's own cookie-signing secret, at least 32 characters (never the platform's key)
LAB_SESSION_SECRET=
# Daily jobs (Lab Records, Document Store, Floor Stock): the scheduler sends this in the x-cron-secret header to POST /api/cron/daily
CRON_SECRET=
# Optional: WhatsApp Cloud API (Meta). Until all three are set, alerts are kept as "WhatsApp not set up yet".
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=plantops_lab_alert   # approved template with one body variable {{1}} = the alert text
# WHATSAPP_TEMPLATE_LANG=en
# Document Store module (written by: ./scripts/setup-module-db.sh document_store doc_app DOC 3003)
DOC_DATABASE_URL_APP=postgres://doc_app:CHANGE_ME@localhost:5432/plantops
TEST_DOC_DATABASE_URL_APP=postgres://doc_app:CHANGE_ME@localhost:5432/plantops_test
DOC_SESSION_SECRET=
# MODULE_URL_DOCUMENT_STORE=http://localhost:3003
# MODULE_SECRET_DOCUMENT_STORE=
# Files: a folder on this server (default ./.data/documents), or S3-compatible storage when STORAGE_BUCKET is set.
# Setting STORAGE_BUCKET immediately switches reads and writes to S3; existing local files are not copied.
# DOC_STORAGE_DIR=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# STORAGE_REGION=ap-south-1
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# Nightly encrypted backup copy of this app's files (docs/HANDBOOK.md "Backups"). Off while BACKUP_BUCKET is unset.
# Same five on every app that stores files. BACKUP_RECIPIENT is the PUBLIC key (age1...) - never the private key.
# BACKUP_BUCKET=plantops-backup
# BACKUP_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# BACKUP_REGION=auto
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_RECIPIENT=
# Floor Stock module (written by: ./scripts/setup-module-db.sh floor_stock stock_app STOCK 3002)
STOCK_DATABASE_URL_APP=postgres://stock_app:CHANGE_ME@localhost:5432/plantops
TEST_STOCK_DATABASE_URL_APP=postgres://stock_app:CHANGE_ME@localhost:5432/plantops_test
STOCK_SESSION_SECRET=
# MODULE_URL_FLOOR_STOCK=http://localhost:3002
# MODULE_SECRET_FLOOR_STOCK=

# Complaint Box module (written by: ./scripts/setup-module-db.sh complaint_box complaint_app COMPLAINT 3004)
COMPLAINT_DATABASE_URL_APP=postgres://complaint_app:CHANGE_ME@localhost:5432/plantops
TEST_COMPLAINT_DATABASE_URL_APP=postgres://complaint_app:CHANGE_ME@localhost:5432/plantops_test
COMPLAINT_SESSION_SECRET=
# MODULE_URL_COMPLAINT_BOX=http://localhost:3004
# MODULE_SECRET_COMPLAINT_BOX=
# Complaint Box photos / videos: its OWN folder or bucket, never Document Store's (default folder ./.data/complaints;
# on Railway a volume, e.g. /data/complaints). With a bucket it uses the same STORAGE_ENDPOINT / REGION / keys.
# COMPLAINT_STORAGE_DIR=
# COMPLAINT_STORAGE_BUCKET=

# Order Capture module (written by: ./scripts/setup-module-db.sh order_capture order_app ORDER 3005). No files, no email.
ORDER_DATABASE_URL_APP=postgres://order_app:CHANGE_ME@localhost:5432/plantops
TEST_ORDER_DATABASE_URL_APP=postgres://order_app:CHANGE_ME@localhost:5432/plantops_test
ORDER_SESSION_SECRET=
# MODULE_URL_ORDER_CAPTURE=http://localhost:3005
# MODULE_SECRET_ORDER_CAPTURE=
# WhatsApp thank-you to the customer on "Delivered" (Twilio; order-capture service only). Off without all three; a plant
# not listed in TWILIO_WHATSAPP_SENDERS has no tick box. "from" is "whatsapp:+91…" or a Messaging Service SID (MG…);
# content_sid is the plant's approved Content Template (HX…), whose {{1}} receives the customer's name.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_SENDERS={"<plant id>": {"from": "whatsapp:+91XXXXXXXXXX", "content_sid": "HX..."}}
# WhatsApp bot API (docs/WHATSAPP_CONTRACT.md 3.6; order-capture service only). Off when empty. Only each key's SHA-256
# is here; make a key with: pnpm --filter order-capture bot:key <plant id>. Rotation: add the new entry next to the old.
# ORDER_BOT_KEYS=[{"id":"<uuid>","tenant_id":"<plant id>","sha256":"<hex>","label":"Bluemins WhatsApp bot","products":["PV_BM_1","PV_BM_500","PV_BM_250"]}]
# off = the bot may not create orders (403 ordering_off; the bot makes them Sheet leads); reads and alerts keep working.
# ORDER_BOT_ORDERS=off

# Attendance module (written by: ./scripts/setup-module-db.sh attendance_salary attendance_app ATTEND 3006). No files, no email.
ATTEND_DATABASE_URL_APP=postgres://attendance_app:CHANGE_ME@localhost:5432/plantops
TEST_ATTEND_DATABASE_URL_APP=postgres://attendance_app:CHANGE_ME@localhost:5432/plantops_test
ATTEND_SESSION_SECRET=
# MODULE_URL_ATTENDANCE_SALARY=http://localhost:3006
# MODULE_SECRET_ATTENDANCE_SALARY=

# Job applications module (written by: ./scripts/setup-module-db.sh job_applications jobs_app JOBS 3007)
JOBS_DATABASE_URL_APP=postgres://jobs_app:CHANGE_ME@localhost:5432/plantops
TEST_JOBS_DATABASE_URL_APP=postgres://jobs_app:CHANGE_ME@localhost:5432/plantops_test
JOBS_SESSION_SECRET=
# MODULE_URL_JOB_APPLICATIONS=http://localhost:3007
# MODULE_SECRET_JOB_APPLICATIONS=
# The plant whose job page is at the bare address (e.g. jobs.bluemins.life/); others are at /<plant code>.
# JOBS_DEFAULT_PLANT=001
# Resume files: a local folder (default .data/jobs), or this module's own S3 bucket (same STORAGE_* keys as Document Store).
# JOBS_STORAGE_DIR=
# JOBS_STORAGE_BUCKET=
# Cloudflare Turnstile (free spam check on the public form): both, or neither (docs/HANDBOOK.md). Never commit real keys.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Email: NOT USED. PlantOps sends no email (owner 2026-10-17, STABILITY_PLAN B-02); leave all of these unset, and
# reminders / low-stock alerts go by app notification only. Kept to bring email back: Brevo's HTTPS API
# (Railway Hobby blocks outgoing SMTP):
# BREVO_API_KEY=
# or SMTP (Amazon SES Mumbai, Zoho, Google Workspace...; ignored while BREVO_API_KEY is set).
# SMTP_USER and SMTP_PASS go together. MAIL_FROM is needed for both.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="PlantOps <reminders@example.com>"
