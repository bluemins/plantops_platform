# Copy to .env (or run scripts/setup-local-db.sh, which generates it). Never commit real values.
# Three database logins - see CLAUDE.md "Row-level security rules":
#   OWNER = migrations only, APP = plant-user requests (RLS), SUPER = super_admin routes only
DATABASE_URL_OWNER=postgres://plantops_owner:CHANGE_ME@localhost:5432/plantops
DATABASE_URL_APP=postgres://platform_app:CHANGE_ME@localhost:5432/plantops
DATABASE_URL_SUPER=postgres://platform_super:CHANGE_ME@localhost:5432/plantops
TEST_DATABASE_URL_OWNER=postgres://plantops_owner:CHANGE_ME@localhost:5432/plantops_test
TEST_DATABASE_URL_APP=postgres://platform_app:CHANGE_ME@localhost:5432/plantops_test
TEST_DATABASE_URL_SUPER=postgres://platform_super:CHANGE_ME@localhost:5432/plantops_test
PLATFORM_URL=http://localhost:3000
# Ed25519 private key for signing SSO tokens: output of `pnpm sso:keygen`
SSO_PRIVATE_JWK_B64=
# Optional: old public key (base64 JWK) still published during a key change
SSO_PREVIOUS_PUBLIC_JWK_B64=
# First super_admin, created by `pnpm db:seed`
SUPER_ADMIN_EMAIL=admin@plantops.local
SUPER_ADMIN_PASSWORD=
# Optional per module: URL and client secret, registered by `pnpm db:seed`
# MODULE_URL_LAB_RECORDS=http://localhost:3001
# MODULE_SECRET_LAB_RECORDS=
# Lab Records module (written by scripts/setup-lab-db.sh). Its migrations run with DATABASE_URL_OWNER.
LAB_DATABASE_URL_APP=postgres://lab_app:CHANGE_ME@localhost:5432/plantops
TEST_LAB_DATABASE_URL_APP=postgres://lab_app:CHANGE_ME@localhost:5432/plantops_test
# The module's own cookie-signing secret, at least 32 characters (never the platform's key)
LAB_SESSION_SECRET=
# Lab Records daily reminder job: the scheduler sends this in the x-cron-secret header to POST /api/cron/daily
CRON_SECRET=
# Optional: WhatsApp Cloud API (Meta). Until all three are set, alerts are kept as "WhatsApp not set up yet".
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_TEMPLATE=plantops_lab_alert   # approved template with one body variable {{1}} = the alert text
# WHATSAPP_TEMPLATE_LANG=en
# Document Store module (written by: ./scripts/setup-module-db.sh document_store doc_app DOC 3003)
DOC_DATABASE_URL_APP=postgres://doc_app:CHANGE_ME@localhost:5432/plantops
TEST_DOC_DATABASE_URL_APP=postgres://doc_app:CHANGE_ME@localhost:5432/plantops_test
DOC_SESSION_SECRET=
# MODULE_URL_DOCUMENT_STORE=http://localhost:3003
# MODULE_SECRET_DOCUMENT_STORE=
# Files: a folder on this server (default ./.data/documents), or S3-compatible storage when STORAGE_BUCKET is set
# DOC_STORAGE_DIR=
# STORAGE_BUCKET=  STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com  STORAGE_REGION=ap-south-1
# STORAGE_ACCESS_KEY_ID=  STORAGE_SECRET_ACCESS_KEY=
# Email reminders (SMTP: Amazon SES Mumbai, Zoho, Google Workspace...). Until set, reminders show "not sent".
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  MAIL_FROM="PlantOps <reminders@example.com>"
